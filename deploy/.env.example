# Public DNS name pointing at the GCP VM. A domain is required for automatic TLS.
APP_DOMAIN=gym.example.com
ACME_EMAIL=ops@example.com

# Payment backend settings. Keep this file chmod 600 and never commit it.
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=
CARDCOM_API_PASSWORD=
DEMO_PAYMENT_MODE=true
PAYMENT_SIGNING_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_APP_URL=https://gym.example.com/
PAYMENT_ALLOWED_ORIGIN=https://gym.example.com

# The browser should call the same GCP origin.
VITE_PAYMENT_API_URL=https://gym.example.com
MAX_REQUEST_BODY_BYTES=1048576
DATABASE_URL=postgresql://gymflow:CHANGE_ME@postgres:5432/gymflow
POSTGRES_PASSWORD=CHANGE_ME
CLUB_ID=baly-wellness
STATE_SYNC_TOKEN=replace-with-at-least-32-random-bytes
