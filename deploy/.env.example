# Public DNS name pointing at the GCP VM. A domain is required for automatic TLS.
APP_DOMAIN=gym.example.com
ACME_EMAIL=ops@example.com

# AI workout assistant. OPENAI_API_KEY must never be exposed to the browser.
OPENAI_API_KEY=
OPENAI_WORKOUT_MODEL=gpt-5.4-mini
OPENAI_WORKOUT_MAX_OUTPUT_TOKENS=12000
AI_REQUESTS_PER_HOUR=30
AI_ALLOWED_ORIGIN=https://gym.example.com
VITE_AI_API_URL=https://gym.example.com

# First production manager. Required only when the database has no manager account yet.
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=robi@rubisgym.co.il
INITIAL_ADMIN_PHONE=054-6995885

# Pulseem SMS authentication. Keep the API key and signing secret server-side only.
PULSEEM_API_KEY=
PULSEEM_FROM_NUMBER=
PULSEEM_PHONE_FORMAT=local
PULSEEM_TIMEOUT_MS=10000
SMS_OTP_SIGNING_SECRET=replace-with-at-least-32-random-bytes
SMS_OTP_TTL_SECONDS=300
SMS_OTP_MAX_ATTEMPTS=5
SMS_OTP_REQUESTS_PER_HOUR=5
SMS_OTP_COOLDOWN_SECONDS=60
SMS_PHONE_VERIFICATION_TTL_SECONDS=7200
# Use true only in a local/test environment. Production must use false.
SMS_TEST_MODE=false

# Payment backend settings. Keep this file chmod 600 and never commit it.
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=
CARDCOM_API_PASSWORD=
DEMO_PAYMENT_MODE=true
PAYMENT_SIGNING_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_APP_URL=https://gym.example.com/
PAYMENT_ALLOWED_ORIGIN=https://gym.example.com

# The browser should call the same GCP origin.
VITE_PAYMENT_API_URL=https://gym.example.com
MAX_REQUEST_BODY_BYTES=1048576
DATABASE_URL=postgresql://gymflow:CHANGE_ME@postgres:5432/gymflow
DATABASE_SSL=false
POSTGRES_PASSWORD=CHANGE_ME
CLUB_ID=baly-wellness

# Web Push. VAPID keys must remain stable so installed devices stay subscribed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
