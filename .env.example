# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public application URL used by the existing app runtime.
APP_URL="MY_APP_URL"

# OpenAI workout-planning assistant. Keep OPENAI_API_KEY server-side only.
OPENAI_API_KEY=
OPENAI_WORKOUT_MODEL=gpt-5.4-mini
OPENAI_WORKOUT_MAX_OUTPUT_TOKENS=12000
AI_REQUESTS_PER_HOUR=30
AI_ALLOWED_ORIGIN=http://localhost:3000
VITE_AI_API_URL=http://localhost:8080

# RIVHIT iCredit hosted-payment integration. Never commit real credentials.
VITE_PAYMENT_API_URL=https://your-payment-backend.example.com
RIVHIT_ENVIRONMENT=test
RIVHIT_GROUP_PRIVATE_TOKEN=
RIVHIT_ENABLE_RECURRING=false
RIVHIT_USE_3DS=false
PAYMENT_SIGNING_SECRET=
PUBLIC_APP_URL=https://menibl.github.io/rubigym/
PAYMENT_STAGING_APP_URL=https://menibl.github.io/rubigym/
PUBLIC_LANDING_URL=https://join.example.com/
LANDING_DOMAIN=join.example.com
PAYMENT_ALLOWED_ORIGIN=https://menibl.github.io
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gymflow
CLUB_ID=baly-wellness
STATE_SYNC_TOKEN=

# Web Push. Generate one stable VAPID key pair and keep the private key server-side only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com
