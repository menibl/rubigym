  "version": "0.0.0",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "sync:ai-prompt": "node scripts/sync-workout-ai-prompt.mjs",
    "predev": "npm run sync:ai-prompt",
